# 서버·클라이언트 로컬 설정 예시
# Django 로컬 실행
# 비우면 실행 시 임의 키 생성. 유지할 키는 외부 환경변수로 지정
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_DB_PATH=로컬 SQLite 파일의 절대 경로

# Python 수집·내려받기
URINATION_API_URL=http://127.0.0.1:8000
URINATION_API_TOKEN=
URINATION_API_USERNAME=
URINATION_API_PASSWORD=

# Android 에뮬레이터에서는 URINATION_API_URL=http://10.0.2.2:8000
